# Backend API base URL (the web app never connects directly to PostgreSQL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# API Mode: "mock" (in-browser mock adapter, default) | "live" (real backend API above)
NEXT_PUBLIC_API_MODE=mock

# Legacy alias, still honored by the API client when NEXT_PUBLIC_API_URL is unset
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
